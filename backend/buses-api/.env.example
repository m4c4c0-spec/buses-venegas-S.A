# =============================================================
# VARIABLES DE ENTORNO REQUERIDAS - BUSES VENEGAS S.A. BACKEND
# =============================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env.local
#   2. Rellena con tus valores reales
#   3. NUNCA commitees el archivo .env.local
#
# Para produccion (Render), configura en: Environment > Add Variable
# =============================================================

# Puerto del servidor (Render lo inyecta automáticamente)
PORT=8081

# Base de datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/buses
SPRING_DATASOURCE_USERNAME=buses
SPRING_DATASOURCE_PASSWORD=tu_password_segura

# Hibernate: usar 'validate' en produccion, 'update' solo en desarrollo
HIBERNATE_DDL_AUTO=update

# Flyway: 'false' en desarrollo si usas ddl-auto, 'true' en produccion
FLYWAY_ENABLED=false

# JWT Secret (generar con: openssl rand -base64 32)
# DEBE ser al menos 256 bits de entropia
JWT_SECRET=genera-aqui-con-openssl-rand-base64-32

# Email (Gmail SMTP)
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_de_gmail

# MercadoPago Access Token (obtenido en mercadopago.com/developers)
# TEST: TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PRODUCCION: APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_ACCESS_TOKEN=TEST-XXXXXXXX

# URL del frontend (para back_urls de MercadoPago)
FRONTEND_URL=http://localhost:5173

# SonarQube (solo para análisis de código, NO en produccion)
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=tu_nuevo_token_sonarqube

# CORS: orígenes permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Blockchain (Sepolia testnet)
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/TU_PROJECT_ID
BLOCKCHAIN_PRIVATE_KEY=tu_clave_privada_wallet
BLOCKCHAIN_CONTRACT_ADDRESS=0xTU_CONTRATO
