# =============================================================
# VARIABLES DE ENTORNO REQUERIDAS - BUSES VENEGAS S.A. FRONTEND
# =============================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env.development.local
#   2. Rellena los valores con tus credenciales reales
#   3. NUNCA commitees el archivo .env.development.local
#
# Para produccion (Vercel), configura estas variables en:
#   Settings > Environment Variables
# =============================================================

# URL base del backend Spring Boot
# Desarrollo: http://localhost:8081
# Produccion: https://tu-app.onrender.com
VITE_API_BASE_URL=http://localhost:8081

# Public key de MercadoPago (se obtiene en mercadopago.com/developers)
# TEST: APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PRODUCCION: APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
